+function drawTwoLines(canvas,a,b,ca,cb){
+  a=Array.isArray(a)?a:[]; b=Array.isArray(b)?b:[];
+  const W=canvas.width=canvas.clientWidth,H=canvas.height;
+  const ctx=canvas.getContext('2d');ctx.clearRect(0,0,W,H);
+  const all=[...a.map(p=>p[1]),...b.map(p=>p[1])];
+  if(!all.length) return;
+  const lo=Math.min(...all),hi=Math.max(...all)||1;
+  const plot=(pts,col)=>{if(pts.length<2)return;ctx.strokeStyle=col;ctx.lineWidth=1.6;ctx.beginPath();
