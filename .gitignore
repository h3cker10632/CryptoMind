.secrets.json

# External-signal ingest store (crawl4ai/Maxun/etc. output — may contain data)
external_signals.jsonl

# Strategy Researcher promoted-candidate store (runtime state)
discovered_strategies.json

# versioned market data store (app/data/store.py) — anchored to the repo
# root: a bare `data/` also matched app/data/ and kept store.py / sources.py
# out of git
/data/

# local scratch / backups / generated output
tmp*
_backup_pre_fix_*/
artifacts/
